/* =====================================
        Rofi Theme: Haku Theme :>
 =======================================*/

@import "../../.local/state/haku_theme/rofi-style.rasi"

/* ===== GLOBAL VARIABLES ===== */
* {
    background:          rgba(0, 0, 0, 0.9);
    foreground:          #dfdfdf;
    modebar-bg:          rgba(27, 27, 27, 0.5);
    background-color:    transparent;
    text-color:          @foreground;

    margin:              0;
    padding:             0;
    spacing:             0;
}

/* ===== MAIN WINDOW ===== */
window {
    width:               40%;
    height:              60%;
    /*border:              1px;*/
    /*border-color:        #000000;*/
    border-radius:       0px;
    padding:             5px;
    background-color:    transparent;
}

mainbox {
    spacing:             10px;
    background-color:    rgba(0, 0, 0, 0.9);
    border-radius:       0px;
    padding:             10px;
    children:            [ inputbar, mode-switcher, listview ];
}

/* ===== INPUT BAR ===== */
inputbar {
    padding:             8px;
    background-color:    rgba(0, 0, 0, 0.2);
    border-radius:       0px;
    children:            [ prompt, entry ];
}

prompt {
    padding:             8px 12px;
    background-color:    @accent;
    text-color:          @background;
    border-radius:       0px;
    font-weight:         bold;
}

entry {
    padding:             8px;
    margin:              0 8px 0 8px;
    text-color:          @accent;
    placeholder:         "Search...";
    placeholder-color:   rgba(223, 223, 223, 0.4);
}

/* ===== MODE SWITCHER (Apps/Run/Window) ===== */
mode-switcher {
    margin:              0px 8px;
    padding:             5px;
    background-color:    @accent;
    border-radius:       0px;
    spacing:             8px;
}

button {
    padding:             6px 12px;
    border-radius:       0px;
    background-color:    transparent;
    text-color:          @background;
}

button selected {
    background-color:    @background;
    text-color:          @accent;
}

/* ===== LISTVIEW ===== */
listview {
    margin:              0px 0px 0px 0px;
    scrollbar:           true;
    cycle:               true;
    dynamic:             true;
}

/* ===== ELEMENTS ===== */
element {
    padding:             8px;
    margin:              2px 8px;
    border-radius:       0px;
    orientation:         horizontal;
    vertical-align:      0.5;
}

element-icon {
    size:                22px;
    margin:              0 8px 0 0;
    vertical-align:      0.5;
}

element-text {
    text-color:          @accent;
    vertical-align:      0.5;
}

/* ===== ELEMENT STATES ===== */
element selected {
    background-color:    @accent;
}

element-text selected {
    text-color:          @background;
}

element-icon selected {
    background-color:    transparent;
}

/* ===== SCROLLBAR ===== */
scrollbar {
    handle-width:           6px;
    handle-color:           @accent;
    handle-rounded-corners: true;
    padding:                0px 0px 0px 6px;
}
