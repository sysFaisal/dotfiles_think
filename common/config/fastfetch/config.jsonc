{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logoarch12.txt",
    "position": "left",
    "padding": {
        "right": 5
    },
    "color": { "1": "blue" }
    },

    "display": {
    "separator": "  ",
    "color": { "keys": "blue", "output": "blue", "title": "blue" },
    "constants": ["\u001b[34m", "\u001b[34m"]
    },

    "modules": [
    "break",
    {
        "type": "custom",
        "key": "╭───────────╮"
    },
    {
        "type": "command",
        "key": "│  user    │",
        "text": "echo $USER"
    },
    {
        "type": "kernel",
        "key": "│ 󰌽 kernel  │"
    },
    {
        "type": "os",
        "key": "│  os      │"
    },
    {
        "type": "wm",
        "key": "│  wm      │"
    },
    {
        "type": "terminal",
        "key": "│  term    │"
    },
    {
    "type": "command",
    "key": "│  cpu     │",
    "text": "lscpu | sed -n 's/^Model name:[[:space:]]*//p' | grep -o 'i[3579]-[0-9A-Z]\\+'"
    },
    {
    "type": "command",
    "key": "│ 󰢮 gpu     │",
    "text": "lspci | grep -m1 'VGA' | grep -o 'UHD Graphics [0-9]\\+' | sed 's/Graphics //'"
    },
    {
        "type": "memory",
        "key": "│  mem     │",
        "format": "{used} / {total}"
    },
    {
    "type": "battery",
    "key": "│ 󰁹 batt    │"
    },
    {
        "type": "disk",
        "key": "│  disk    │",
        "folder": "/",
        "format": "{<12}{$1}"
    },
    {
        "type": "packages",
        "key": "│  pkg     │"
    },
    {
        "type": "custom",
        "key": "╰───────────╯"
    },
    "break"
    ]
}