// This is a niri custom configuration file (small config.kdl actually :p)
// You can add keybindings, rules, and other configurations here.

// Why you should custom your config in there?
// Because for each update, my dotfiles will override your all custom configurations.

// After changes, please reload Niri by `niri msg action load-config-file` on terminal

// See more in the Wiki: https://github.com/niri-wm/niri/wiki

binds {
    Mod+Return { spawn "kitty"; }
}

// Samakan bingkai fokus vs tidak fokus:
// - focus-ring dimatikan total (Niri hanya gambar ring di window fokus,
//   jadi selama ring on, fokus vs tidak fokus tidak akan pernah sama).
// - shadow diberi inactive-color yang sama dengan color, menonaktifkan
//   perilaku bawaan Niri yang meredupkan shadow window tidak fokus.
window-rule {
    match app-id=r#".*"#

    // Paksa border digambar DI SEKELILING window, bukan sebagai kotak
    // solid di belakangnya, agar transparansi Kitty tetap hidup.
    draw-border-with-background false


    // Border dalam: pakai `border` (bukan focus-ring) karena border
    // digambar di SEMUA window, sedangkan focus-ring cuma di window fokus.
    // Warna active/inactive disamakan agar fokus vs tidak fokus identik.
    

    // Border hitam luar: hard shadow, warna active/inactive disamakan
    // untuk mematikan peredupan shadow bawaan Niri di window tidak fokus.
    shadow {
        on
        softness 1
        spread 5
        offset x=0 y=0
        color "rgba(0, 0, 0, 0.88)"
        inactive-color "rgba(0, 0, 0, 0.88)"

        draw-behind-window false
    }
}